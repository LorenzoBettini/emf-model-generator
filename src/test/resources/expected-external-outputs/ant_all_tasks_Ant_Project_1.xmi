<?xml version="1.0" encoding="ASCII"?>
<ant:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ant="http://example.org/atlantic-zoo/ant"
    xsi:schemaLocation="http://example.org/atlantic-zoo/ant ../external-metamodels/Ant.ecore#/0"
    name="Project_name_1"
    basedir="Project_basedir_1"
    description="Project_description_1"
    default="//@targets.0">
  <path id="Path_id_1"
      refid="Path_refid_1">
    <path id="Path_id_2"
        refid="Path_refid_2"/>
    <pathElement
        path="PathElement_path_1"
        location="PathElement_location_1"/>
    <pathElement
        path="PathElement_path_2"
        location="PathElement_location_2"/>
    <fileset
        dir="FileSet_dir_1"/>
    <fileset
        dir="FileSet_dir_2"/>
  </path>
  <properties
      xsi:type="ant:PropertyValue"
      name="PropertyValue_name_1"
      value="PropertyValue_value_1"/>
  <properties
      xsi:type="ant:PropertyLocation"
      name="PropertyLocation_name_1"
      location="PropertyLocation_location_1"/>
  <taskdef name="TaskDef_name_1"
      classname="TaskDef_classname_1"/>
  <taskdef name="TaskDef_name_2"
      classname="TaskDef_classname_2"/>
  <targets name="Target_name_1"
      description="Target_description_1"
      unless="Target_unless_1"
      ifCondition="Target_ifCondition_1">
    <tasks xsi:type="ant:NewTask"
        taskName="//@taskdef.0"/>
    <tasks xsi:type="ant:Exec"
        id="Exec_id_1"
        taskname="Exec_taskname_1"
        description="Exec_description_1"
        executable="Exec_executable_1"
        dir="Exec_dir_1"/>
    <tasks xsi:type="ant:Java"
        id="Java_id_1"
        taskname="Java_taskname_1"
        description="Java_description_1"
        classname="Java_classname_1"
        jar="Java_jar_1"
        fork="Java_fork_1"/>
    <tasks xsi:type="ant:Echo"
        id="Echo_id_1"
        taskname="Echo_taskname_1"
        description="Echo_description_1"
        message="Echo_message_1"
        file="Echo_file_1"
        append="Echo_append_1"/>
    <tasks xsi:type="ant:Tstamp"
        id="Tstamp_id_1"
        taskname="Tstamp_taskname_1"
        description="Tstamp_description_1"/>
    <tasks xsi:type="ant:Javac"
        id="Javac_id_1"
        taskname="Javac_taskname_1"
        description="Javac_description_1"
        srcdir="Javac_srcdir_1"
        destdir="Javac_destdir_1"
        debug="Javac_debug_1"
        fork="Javac_fork_1"
        optimize="Javac_optimize_1"
        deprecation="Javac_deprecation_1"/>
    <tasks xsi:type="ant:Javadoc"
        id="Javadoc_id_1"
        taskname="Javadoc_taskname_1"
        description="Javadoc_description_1"
        sourcepath="Javadoc_sourcepath_1"
        destdir="Javadoc_destdir_1"
        packagenames="Javadoc_packagenames_1"
        defaultexcludes="Javadoc_defaultexcludes_1"
        author="Javadoc_author_1"
        version="Javadoc_version_1"
        use="Javadoc_use_1"
        windowtitle="Javadoc_windowtitle_1"/>
    <tasks xsi:type="ant:Jar"
        id="Jar_id_1"
        taskname="Jar_taskname_1"
        description="Jar_description_1"
        jarfile="Jar_jarfile_1"
        basedir="Jar_basedir_1"
        compress="Jar_compress_1"
        encoding="Jar_encoding_1"
        manifest="Jar_manifest_1"/>
    <tasks xsi:type="ant:Mkdir"
        id="Mkdir_id_1"
        taskname="Mkdir_taskname_1"
        description="Mkdir_description_1"
        dir="Mkdir_dir_1"/>
    <tasks xsi:type="ant:Copy"
        id="Copy_id_1"
        taskname="Copy_taskname_1"
        description="Copy_description_1"
        file="Copy_file_1"
        presservelastmodified="Copy_presservelastmodified_1"
        tofile="Copy_tofile_1"
        todir="Copy_todir_1"
        overwrite="Copy_overwrite_1"
        filtering="Copy_filtering_1"
        flatten="Copy_flatten_1"
        includeEmptyDirs="Copy_includeEmptyDirs_1"/>
    <tasks xsi:type="ant:Delete"
        id="Delete_id_1"
        taskname="Delete_taskname_1"
        description="Delete_description_1"
        file="Delete_file_1"
        dir="Delete_dir_1"
        verbose="Delete_verbose_1"
        quiet="Delete_quiet_1"
        failonerror="Delete_failonerror_1"
        includeEmptyDirs="Delete_includeEmptyDirs_1"
        includes="Delete_includes_1"
        includesfile="Delete_includesfile_1"
        excludes="Delete_excludes_1"
        excludesfile="Delete_excludesfile_1"
        defaultexcludes="Delete_defaultexcludes_1"/>
  </targets>
</ant:Project>
